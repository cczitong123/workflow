BMWCODE_HOST=127.0.0.1
BMWCODE_PORT=8000
BMWCODE_EPIC_DATA_DIR=./data/epics
BMWCODE_PROMPT_DIR=./apps/api/src/prompts

# Code RAG
# Keep mode=local for your current setup. Fill the two local paths below.
BMWCODE_CODE_RAG_MODE=local
BMWCODE_CODE_RAG_EMBEDDING_MODEL_PATH=./local_jina-code-embeddings-1.5b
BMWCODE_CODE_RAG_VECTOR_STORE_PATH=./ce_jina-code-embeddings-1.5b/codebase_embeddings_clang_800.json
BMWCODE_CODE_RAG_METADATA_PATH=
BMWCODE_CODE_RAG_DEVICE=cpu
BMWCODE_CODE_RAG_TOP_K=20

# LLM
# Keep mode=remote for your current setup.
BMWCODE_LLM_MODE=remote
BMWCODE_LLM_LOCAL_MODEL_PATH=
BMWCODE_LLM_DEVICE=
BMWCODE_LLM_ENDPOINT=https://api.gcp.cloud.bmw/llmapi
BMWCODE_LLM_API_PATH=/v1/chat/completions
BMWCODE_LLM_MODEL=gpt-5.1
BMWCODE_LLM_API_KEY=PASTE_APIGEE_API_KEY_HERE
BMWCODE_LLM_ACCESS_TOKEN=
BMWCODE_LLM_CERT_PATH=./BMW_Trusted_Certificates_Latest.pem
BMWCODE_LLM_AUTH_URL=https://auth.bmwgroup.net/auth/oauth2/realms/root/realms/machine2machine/access_token
BMWCODE_LLM_CLIENT_ID=PASTE_CLIENT_ID_HERE
BMWCODE_LLM_CLIENT_SECRET=PASTE_CLIENT_SECRET_HERE
BMWCODE_LLM_TIMEOUT_SECONDS=60
BMWCODE_LLM_TEMPERATURE=0.2
BMWCODE_LLM_MAX_TOKENS=1200
BMWCODE_LLM_TOP_P=1.0
BMWCODE_LLM_PRESENCE_PENALTY=0.0
BMWCODE_LLM_FREQUENCY_PENALTY=0.0
