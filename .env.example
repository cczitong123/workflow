AGENTIC_WORKFLOW_HOST=0.0.0.0
AGENTIC_WORKFLOW_PORT=8000
AGENTIC_WORKFLOW_EPIC_DATA_DIR=./data/epics
AGENTIC_WORKFLOW_PROMPT_DIR=./apps/api/src/prompts
AGENTIC_WORKFLOW_STORAGE_DB_PATH=./data/agentic_workflow.sqlite3

# Code RAG
AGENTIC_WORKFLOW_CODE_RAG_MODE=local
AGENTIC_WORKFLOW_CODE_RAG_EMBEDDING_MODEL_PATH=PASTE_LOCAL_EMBEDDING_MODEL_PATH_HERE
AGENTIC_WORKFLOW_CODE_RAG_VECTOR_STORE_PATH=PASTE_LOCAL_VECTOR_STORE_JSON_PATH_HERE
AGENTIC_WORKFLOW_CODE_RAG_METADATA_PATH=
AGENTIC_WORKFLOW_CODE_RAG_DEVICE=cpu
AGENTIC_WORKFLOW_CODE_RAG_RANKING_MODE=weight
AGENTIC_WORKFLOW_CODE_RAG_RANKING_ALPHA=0.7
AGENTIC_WORKFLOW_CODE_RAG_RANKING_BETA=0.3
AGENTIC_WORKFLOW_CODE_RAG_FILE_AGGREGATION_STRATEGY=max_plus_second_plus_log_count
AGENTIC_WORKFLOW_CODE_RAG_FILE_AGGREGATION_ALPHA=0.25
AGENTIC_WORKFLOW_CODE_RAG_FILE_AGGREGATION_BETA=0.05
AGENTIC_WORKFLOW_CODE_RAG_FILE_AGGREGATION_CANDIDATE_MULTIPLIER=5
AGENTIC_WORKFLOW_CODE_RAG_TOP_K=20

# LLM
AGENTIC_WORKFLOW_LLM_MODE=remote
AGENTIC_WORKFLOW_LLM_LOCAL_MODEL_PATH=
AGENTIC_WORKFLOW_LLM_DEVICE=
AGENTIC_WORKFLOW_LLM_ENDPOINT=https://api.gcp.cloud.bmw/llmapi
