AGENTIC_WORKFLOW_HOST=127.0.0.1
AGENTIC_WORKFLOW_PORT=8000
AGENTIC_WORKFLOW_EPIC_DATA_DIR=./data/epics
AGENTIC_WORKFLOW_PROMPT_DIR=./apps/api/src/prompts
AGENTIC_WORKFLOW_STORAGE_DB_PATH=./data/agentic_workflow.sqlite3

# Code RAG
AGENTIC_WORKFLOW_CODE_RAG_MODE=local
AGENTIC_WORKFLOW_CODE_RAG_EMBEDDING_MODEL_PATH=PASTE_LOCAL_EMBEDDING_MODEL_PATH_HERE
AGENTIC_WORKFLOW_CODE_RAG_VECTOR_STORE_PATH=PASTE_LOCAL_VECTOR_STORE_JSON_PATH_HERE
AGENTIC_WORKFLOW_CODE_RAG_METADATA_PATH=
AGENTIC_WORKFLOW_CODE_RAG_DEVICE=cpu
AGENTIC_WORKFLOW_CODE_RAG_TOP_K=20

# LLM
AGENTIC_WORKFLOW_LLM_MODE=remote
AGENTIC_WORKFLOW_LLM_LOCAL_MODEL_PATH=
AGENTIC_WORKFLOW_LLM_DEVICE=
AGENTIC_WORKFLOW_LLM_ENDPOINT=https://api.gcp.cloud.bmw/llmapi
AGENTIC_WORKFLOW_LLM_API_PATH=/v1/chat/completions
AGENTIC_WORKFLOW_LLM_MODEL=gpt-5.1
AGENTIC_WORKFLOW_LLM_API_KEY=PASTE_APIGEE_API_KEY_HERE
AGENTIC_WORKFLOW_LLM_ACCESS_TOKEN=
AGENTIC_WORKFLOW_LLM_CERT_PATH=PASTE_CERT_PATH_HERE
AGENTIC_WORKFLOW_LLM_AUTH_URL=https://auth.bmwgroup.net/auth/oauth2/realms/root/realms/machine2machine/access_token
AGENTIC_WORKFLOW_LLM_CLIENT_ID=PASTE_CLIENT_ID_HERE
AGENTIC_WORKFLOW_LLM_CLIENT_SECRET=PASTE_CLIENT_SECRET_HERE
AGENTIC_WORKFLOW_LLM_TIMEOUT_SECONDS=60
AGENTIC_WORKFLOW_LLM_INCLUDE_TUNING_PARAMS=false
AGENTIC_WORKFLOW_LLM_TEMPERATURE=0.2
AGENTIC_WORKFLOW_LLM_MAX_TOKENS=1200
AGENTIC_WORKFLOW_LLM_TOP_P=1.0
AGENTIC_WORKFLOW_LLM_PRESENCE_PENALTY=0.0
AGENTIC_WORKFLOW_LLM_FREQUENCY_PENALTY=0.0

# Jira
AGENTIC_WORKFLOW_JIRA_BASE_URL=https://jira.cc.bmwgroup.net
AGENTIC_WORKFLOW_JIRA_PERSONAL_TOKEN=
AGENTIC_WORKFLOW_JIRA_EPIC_LINK_FIELD=customfield_10109
